rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // CEO: bu Gmail ilə (təsdiqlənmiş) daxil olan avtomatik tam səlahiyyətlidir
    function isCeo() {
      return signedIn() && request.auth.token.email == 'rareacademyy@gmail.com' && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isCeo() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(v, max) { return v == null || (v is string && v.size() <= max); }

    // İstifadəçi profilləri: users/{uid}
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email','fullName','phone','photoURL','role','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['email','fullName','phone','photoURL','role','createdAt','updatedAt'])
        && request.resource.data.role == 'student'
        && optStr(request.resource.data.fullName, 120)
        && request.resource.data.phone == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // yalnız ad və telefon dəyişə bilər (role/email dəyişmək olmaz)
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','phone','updatedAt'])
        && str(request.resource.data.fullName, 3, 120)
        && (request.resource.data.phone == null || str(request.resource.data.phone, 7, 20))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Qeydiyyat müraciətləri: yalnız təsdiqlənmiş (Google / e-poçt kodu) hesab göndərə bilər, oxuyan yalnız admin
    match /registrations/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['fullName','email','program','source','status','userId','createdAt'])
        && request.resource.data.keys().hasOnly(['fullName','email','program','source','status','userId','createdAt'])
        && str(request.resource.data.fullName, 3, 120)
        && str(request.resource.data.program, 1, 80)
        && str(request.resource.data.email, 5, 254)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && request.resource.data.source == 'website'
        && request.resource.data.status == 'new'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);   // öz müraciətini görə bilər
      allow update, delete: if isAdmin();
    }

    // Xəbər abunələri: sənəd ID-si = kiçik hərflə e-poçt (təkrar abunə mümkün deyil)
    match /newsletter/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt'])
        && request.resource.data.email == email
        && email == email.lower()
        && str(email, 5, 254)
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Adminlər: yalnız CEO əlavə/silə bilər
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isCeo();
    }

    // Sayt ayarları və mətnləri: hamı oxuyur, yalnız admin dəyişir
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
